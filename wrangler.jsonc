{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cointap",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "exclude": [
      "node_modules/**",
      ".wrangler/**",
      ".git/**",
      "~$*"
    ]
  }
}
